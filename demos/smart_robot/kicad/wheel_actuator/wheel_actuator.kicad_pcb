(kicad_pcb
  (version 20240108)
  (generator circuitci_smart_robot_wheel_actuator_pcb)

  (net 1 "vwheel_sw")
  (net 2 "gnd")
  (net 3 "3v3_logic")
  (net 4 "5v_aux")
  (net 5 "wheel_can_tx")
  (net 6 "wheel_can_rx")
  (net 7 "robot_canh")
  (net 8 "robot_canl")
  (net 9 "drv_inha")
  (net 10 "drv_inla")
  (net 11 "drv_inhb")
  (net 12 "drv_inlb")
  (net 13 "drv_inhc")
  (net 14 "drv_inlc")
  (net 15 "drv_enable")
  (net 16 "drv_nfault")
  (net 17 "drv_spi_sck")
  (net 18 "drv_spi_mosi")
  (net 19 "drv_spi_miso")
  (net 20 "drv_spi_cs")
  (net 21 "cur_u")
  (net 22 "cur_v")
  (net 23 "cur_w")
  (net 24 "enc_a")
  (net 25 "enc_b")
  (net 26 "enc_z")
  (net 27 "enable_in")
  (net 28 "fault_out")
  (net 29 "sync_in")
  (net 30 "phase_u")
  (net 31 "phase_v")
  (net 32 "phase_w")

  (net_class "CAN_ACTUATOR" "Actuator CAN trunk"
    (clearance 0.20)
    (trace_width 0.20)
    (diff_pair_width 0.20)
    (diff_pair_gap 0.20)
    (add_net "robot_canh")
    (add_net "robot_canl"))

  (net_class "MOTOR_PHASE" "Wheel phase outputs"
    (clearance 0.30)
    (trace_width 1.20)
    (add_net "phase_u")
    (add_net "phase_v")
    (add_net "phase_w"))

  (net_class "MOTOR_POWER" "Wheel switched battery bus"
    (clearance 0.30)
    (trace_width 1.50)
    (add_net "vwheel_sw"))

  (rule "CAN branch length"
    (condition "A.hasNetclass('CAN_ACTUATOR')")
    (constraint length (max 80mm))
    (constraint skew (max 2mm) within_diff_pairs))

  (gr_rect (start 0 0) (end 95 55) (stroke (width 0.10) (type solid)) (fill none) (layer "Edge.Cuts"))

  (footprint "CircuitCI:AT32M416_Motor_Control" (layer "F.Cu")
    (at 24 23 0)
    (property "Reference" "U1" (at 0 0 0) (layer "F.SilkS"))
    (property "Value" "AT32M416" (at 0 1 0) (layer "F.Fab"))
    (fp_rect (start -3 -3) (end 3 3) (stroke (width 0.05) (type solid)) (fill none) (layer "F.Fab"))
    (pad "VDD" smd rect (at -2 -2) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "3v3_logic"))
    (pad "GND" smd rect (at -1 -2) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "gnd"))
    (pad "CAN_TX" smd rect (at 2 -2) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "wheel_can_tx"))
    (pad "CAN_RX" smd rect (at 2 -1) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 6 "wheel_can_rx"))
    (pad "PWM_UH" smd rect (at 2 0) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 9 "drv_inha"))
    (pad "PWM_UL" smd rect (at 2 0.7) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 10 "drv_inla"))
    (pad "PWM_VH" smd rect (at 2 1.4) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 11 "drv_inhb"))
    (pad "PWM_VL" smd rect (at 2 2.1) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 12 "drv_inlb"))
    (pad "PWM_WH" smd rect (at 1 2.6) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 13 "drv_inhc"))
    (pad "PWM_WL" smd rect (at 0 2.6) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 14 "drv_inlc"))
    (pad "DRV_EN" smd rect (at -1 2.6) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 15 "drv_enable"))
    (pad "DRV_NFAULT" smd rect (at -2 2.6) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 16 "drv_nfault")))

