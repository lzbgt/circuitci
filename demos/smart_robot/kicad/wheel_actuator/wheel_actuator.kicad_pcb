    (pad "INHC" smd rect (at -2 2.4) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 13 "drv_inhc"))
    (pad "INLC" smd rect (at -1.3 2.4) (size 0.35 0.35) (layers "F.Cu" "F.Paste" "F.Mask") (net 14 "drv_inlc"))
