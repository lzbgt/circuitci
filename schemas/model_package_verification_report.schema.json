{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/model_package_verification_report.schema.json",
  "title": "CircuitCI Model Package Verification Report",
  "type": "object",
  "required": ["schema_version", "result", "lock", "registry", "artifacts", "findings"],
  "properties": {
    "schema_version": { "const": "circuitci.model_package_verification.v1" },
    "result": { "enum": ["pass", "fail"] },
    "lock": {
      "type": "object",
      "required": ["path", "sha256", "package_name", "package_version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"] },
        "package_name": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": ["object", "null"],
      "required": ["path", "sha256", "entry", "lock_path", "lock_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"] },
        "entry": { "type": "string" },
        "lock_path": { "type": ["string", "null"] },
        "lock_sha256": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "artifact_format",
          "compiler",
          "sha256_declared",
          "sha256_actual",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "artifact_format": { "type": ["string", "null"] },
          "compiler": { "type": ["string", "null"] },
          "sha256_declared": { "type": ["string", "null"] },
          "sha256_actual": { "type": ["string", "null"] },
          "status": { "enum": ["verified", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "message",
          "package",
          "artifact_id",
          "path",
          "expected_sha256",
          "actual_sha256"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical"] },
          "message": { "type": "string", "minLength": 1 },
          "package": { "type": ["string", "null"] },
          "artifact_id": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "expected_sha256": { "type": ["string", "null"] },
          "actual_sha256": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
