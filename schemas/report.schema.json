{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/report.schema.json",
  "title": "CircuitCI Validation Report",
  "type": "object",
  "required": ["schema_version", "project", "profile", "result", "summary"],
  "properties": {
    "schema_version": { "type": "string" },
    "project": { "type": "string" },
    "profile": { "type": "string" },
    "result": { "enum": ["pass", "fail"] },
    "summary": {
      "type": "object",
      "required": ["critical", "warning", "info"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "failures": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "infos": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "waveforms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "distortion_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/distortion_summary" }
    },
    "fourier_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/fourier_summary" }
    },
    "pole_zero_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/pole_zero_summary" }
    },
    "sensitivity_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/sensitivity_summary" }
    },
    "transfer_function_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/transfer_function_summary" }
    },
    "s_parameter_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/s_parameter_summary" }
    },
    "s_parameter_network_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/s_parameter_network_summary" }
    },
    "model_file_provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/model_file_provenance" }
    },
    "model_package_conformance_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/model_package_conformance_check" }
    },
    "model_package_bundle_verifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/model_package_bundle_verification" }
    },
    "model_package_bundle_installs": {
      "type": "array",
      "items": { "$ref": "#/$defs/model_package_bundle_install" }
    },
    "model_package_bundle_imports": {
      "type": "array",
      "items": { "$ref": "#/$defs/model_package_bundle_import" }
    },
    "yaml_repairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/yaml_repair" }
    },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } },
    "suggested_next_actions": { "type": "array" },
    "reproduction": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["component", "pin"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "pin": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "scenario", "message", "suggested_fixes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "warning", "info"] },
        "scenario": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "component": { "type": "string" },
        "net": { "type": "string" },
        "endpoints": {
          "type": "object",
          "properties": {
            "driver": { "$ref": "#/$defs/endpoint" },
            "victim": { "$ref": "#/$defs/endpoint" }
          },
          "additionalProperties": false
        },
        "measured": { "type": "object" },
        "limit": { "type": "object" },
        "suggested_fixes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["id", "scope", "confidence", "blocking", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "blocking": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "distortion_summary": {
      "type": "object",
      "required": [
        "artifact",
        "component",
        "output_expression",
        "row_count",
        "max_magnitude",
        "frequency_hz_at_max"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "output_expression": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 0 },
        "max_magnitude": { "type": "number" },
        "frequency_hz_at_max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "fourier_summary": {
      "type": "object",
      "required": [
        "artifact",
        "output_expression",
        "harmonic",
        "frequency_hz",
        "magnitude",
        "phase_deg",
        "normalized_magnitude",
        "normalized_phase_deg",
        "thd_percent"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "output_expression": { "type": "string" },
        "harmonic": { "type": "integer", "minimum": 0 },
        "frequency_hz": { "type": "number" },
        "magnitude": { "type": "number" },
        "phase_deg": { "type": "number" },
        "normalized_magnitude": { "type": "number" },
        "normalized_phase_deg": { "type": "number" },
        "thd_percent": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "pole_zero_summary": {
      "type": "object",
      "required": [
        "artifact",
        "output_node",
        "reference_node",
        "input_source",
        "mode",
        "root_kind",
        "root_index",
        "real_rad_per_s",
        "imaginary_rad_per_s",
        "frequency_hz"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "output_node": { "type": "string", "minLength": 1 },
        "reference_node": { "type": "string", "minLength": 1 },
        "input_source": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["poles", "zeros", "poles_and_zeros"] },
        "root_kind": { "enum": ["pole", "zero"] },
        "root_index": { "type": "integer", "minimum": 1 },
        "real_rad_per_s": { "type": "number" },
        "imaginary_rad_per_s": { "type": "number" },
        "frequency_hz": { "type": "number" }
      },
      "additionalProperties": false
    },
    "sensitivity_summary": {
      "type": "object",
      "required": [
        "artifact",
        "output_expression",
        "mode",
        "parameter",
        "frequency_hz",
        "sensitivity_real",
        "sensitivity_imaginary",
        "sensitivity_magnitude"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "output_expression": { "type": "string" },
        "mode": { "enum": ["dc", "ac"] },
        "parameter": { "type": "string", "minLength": 1 },
        "frequency_hz": { "type": ["number", "null"] },
        "sensitivity_real": { "type": "number" },
        "sensitivity_imaginary": { "type": "number" },
        "sensitivity_magnitude": { "type": "number" }
      },
      "additionalProperties": false
    },
    "transfer_function_summary": {
      "type": "object",
      "required": [
        "artifact",
        "output_expression",
        "input_source",
        "transfer_function_gain",
        "input_resistance_ohm",
        "output_resistance_ohm"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "output_expression": { "type": "string" },
        "input_source": { "type": "string", "minLength": 1 },
        "transfer_function_gain": { "type": "number" },
        "input_resistance_ohm": { "type": "number" },
        "output_resistance_ohm": { "type": "number" }
      },
      "additionalProperties": false
    },
    "s_parameter_summary": {
      "type": "object",
      "required": [
        "artifact",
        "parameter",
        "row_count",
        "min_frequency_hz",
        "max_frequency_hz",
        "min_mag_db",
        "max_mag_db",
        "min_mag_linear",
        "max_mag_linear",
        "min_return_loss_db",
        "max_return_loss_db",
        "min_insertion_loss_db",
        "max_insertion_loss_db",
        "min_vswr",
        "max_vswr",
        "min_mismatch_loss_db",
        "max_mismatch_loss_db",
        "min_group_delay_s",
        "max_group_delay_s",
        "min_impedance_real_ohm",
        "max_impedance_real_ohm",
        "min_impedance_imag_ohm",
        "max_impedance_imag_ohm",
        "min_impedance_magnitude_ohm",
        "max_impedance_magnitude_ohm"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "parameter": {
          "type": "string",
          "pattern": "^s[1-9][0-9]*[1-9][0-9]*$"
        },
        "row_count": { "type": "integer", "minimum": 0 },
        "min_frequency_hz": { "type": "number" },
        "max_frequency_hz": { "type": "number" },
        "min_mag_db": { "type": "number" },
        "max_mag_db": { "type": "number" },
        "min_mag_linear": { "type": "number" },
        "max_mag_linear": { "type": "number" },
        "min_return_loss_db": { "type": ["number", "null"] },
        "max_return_loss_db": { "type": ["number", "null"] },
        "min_insertion_loss_db": { "type": ["number", "null"] },
        "max_insertion_loss_db": { "type": ["number", "null"] },
        "min_vswr": { "type": ["number", "null"] },
        "max_vswr": { "type": ["number", "null"] },
        "min_mismatch_loss_db": { "type": ["number", "null"] },
        "max_mismatch_loss_db": { "type": ["number", "null"] },
        "min_group_delay_s": { "type": ["number", "null"] },
        "max_group_delay_s": { "type": ["number", "null"] },
        "min_impedance_real_ohm": { "type": ["number", "null"] },
        "max_impedance_real_ohm": { "type": ["number", "null"] },
        "min_impedance_imag_ohm": { "type": ["number", "null"] },
        "max_impedance_imag_ohm": { "type": ["number", "null"] },
        "min_impedance_magnitude_ohm": { "type": ["number", "null"] },
        "max_impedance_magnitude_ohm": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "s_parameter_network_summary": {
      "type": "object",
      "required": [
        "artifact",
        "port_count",
        "row_count",
        "min_frequency_hz",
        "max_frequency_hz",
        "max_reciprocity_error_linear",
        "frequency_hz_at_max_reciprocity_error",
        "max_passivity_singular_value",
        "frequency_hz_at_max_passivity",
        "min_rollet_k",
        "frequency_hz_at_min_rollet_k",
        "max_stability_delta_magnitude",
        "frequency_hz_at_max_stability_delta_magnitude",
        "min_maximum_available_gain_db",
        "frequency_hz_at_min_maximum_available_gain",
        "min_maximum_stable_gain_db",
        "frequency_hz_at_min_maximum_stable_gain",
        "min_maximum_unilateral_gain_db",
        "frequency_hz_at_min_maximum_unilateral_gain",
        "source_reflection_real",
        "source_reflection_imaginary",
        "load_reflection_real",
        "load_reflection_imaginary",
        "min_transducer_gain_db",
        "frequency_hz_at_min_transducer_gain",
        "min_available_gain_db",
        "frequency_hz_at_min_available_gain",
        "min_operating_gain_db",
        "frequency_hz_at_min_operating_gain"
      ],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "port_count": { "type": "integer", "minimum": 2 },
        "row_count": { "type": "integer", "minimum": 0 },
        "min_frequency_hz": { "type": "number" },
        "max_frequency_hz": { "type": "number" },
        "max_reciprocity_error_linear": { "type": "number" },
        "frequency_hz_at_max_reciprocity_error": { "type": "number" },
        "max_passivity_singular_value": { "type": "number" },
        "frequency_hz_at_max_passivity": { "type": "number" },
        "min_rollet_k": { "type": ["number", "null"] },
        "frequency_hz_at_min_rollet_k": { "type": ["number", "null"] },
        "max_stability_delta_magnitude": { "type": ["number", "null"] },
        "frequency_hz_at_max_stability_delta_magnitude": { "type": ["number", "null"] },
        "min_maximum_available_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_maximum_available_gain": { "type": ["number", "null"] },
        "min_maximum_stable_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_maximum_stable_gain": { "type": ["number", "null"] },
        "min_maximum_unilateral_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_maximum_unilateral_gain": { "type": ["number", "null"] },
        "source_reflection_real": { "type": ["number", "null"] },
        "source_reflection_imaginary": { "type": ["number", "null"] },
        "load_reflection_real": { "type": ["number", "null"] },
        "load_reflection_imaginary": { "type": ["number", "null"] },
        "min_transducer_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_transducer_gain": { "type": ["number", "null"] },
        "min_available_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_available_gain": { "type": ["number", "null"] },
        "min_operating_gain_db": { "type": ["number", "null"] },
        "frequency_hz_at_min_operating_gain": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "model_file_provenance": {
      "type": "object",
      "required": [
        "scenario",
        "analysis",
        "backend",
        "manifest",
        "model_file",
        "artifact_format",
        "source_path",
        "source_sha256_declared",
        "source_sha256_actual",
        "artifact_sha256_declared",
        "artifact_sha256_actual",
        "compiler",
        "compiler_version",
        "compiler_command",
        "rebuild_mode"
      ],
      "properties": {
        "scenario": { "type": "string" },
        "analysis": { "type": "string" },
        "backend": { "type": "string" },
        "manifest": { "type": "string", "minLength": 1 },
        "model_file": { "type": "string", "minLength": 1 },
        "artifact_format": { "type": "string" },
        "source_path": { "type": "string" },
        "source_sha256_declared": { "type": "string" },
        "source_sha256_actual": { "type": "string" },
        "artifact_sha256_declared": { "type": "string" },
        "artifact_sha256_actual": { "type": "string" },
        "compiler": { "type": "string" },
        "compiler_version": { "type": "string" },
        "compiler_command": { "type": "string" },
        "model_package_name": { "type": ["string", "null"] },
        "model_package_version": { "type": ["string", "null"] },
        "model_package_artifact_id": { "type": ["string", "null"] },
        "model_package_lock_path": { "type": ["string", "null"] },
        "model_package_lock_sha256": { "type": ["string", "null"] },
        "model_package_registry_path": { "type": ["string", "null"] },
        "model_package_registry_sha256": { "type": ["string", "null"] },
        "model_package_registry_entry": { "type": ["string", "null"] },
        "compiler_available_on_path": { "type": ["boolean", "null"] },
        "build_env_enabled": { "type": ["boolean", "null"] },
        "rebuild_mode": { "type": "string" },
        "produced_by_circuitci": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "model_package_conformance_check": {
      "type": "object",
      "required": [
        "report",
        "report_artifact_id",
        "target_artifact_id",
        "target_artifact_sha256",
        "check_name",
        "analysis",
        "solver",
        "result",
        "artifacts"
      ],
      "properties": {
        "report": { "type": "string" },
        "report_artifact_id": { "type": "string" },
        "target_artifact_id": { "type": "string" },
        "target_artifact_sha256": { "type": "string" },
        "check_name": { "type": "string" },
        "analysis": { "type": "string" },
        "solver": { "type": "string" },
        "result": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "model_package_bundle_verification": {
      "type": "object",
      "required": [
        "report",
        "result",
        "bundle_path",
        "package_name",
        "package_version",
        "manifest_path",
        "manifest_sha256_actual",
        "lock_path",
        "lock_sha256_actual",
        "registry_path",
        "registry_sha256_actual",
        "artifact_count",
        "conformance_check_count",
        "finding_count"
      ],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "result": { "type": "string" },
        "bundle_path": { "type": "string" },
        "package_name": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] },
        "manifest_path": { "type": "string" },
        "manifest_sha256_actual": { "type": ["string", "null"] },
        "lock_path": { "type": ["string", "null"] },
        "lock_sha256_actual": { "type": ["string", "null"] },
        "registry_path": { "type": ["string", "null"] },
        "registry_sha256_actual": { "type": ["string", "null"] },
        "artifact_count": { "type": "integer", "minimum": 0 },
        "conformance_check_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "model_package_bundle_install": {
      "type": "object",
      "required": [
        "report",
        "result",
        "source_bundle",
        "install_dir",
        "package_name",
        "package_version",
        "installed_registry_path",
        "installed_registry_sha256_actual",
        "model_package_registry_path",
        "model_package_registry_sha256",
        "model_package_registry_entry",
        "model_package_lock_path",
        "model_package_lock_sha256",
        "model_package_artifact_id",
        "artifact_count",
        "conformance_check_count",
        "finding_count",
        "repair_yaml_command"
      ],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "result": { "type": "string" },
        "source_bundle": { "type": "string" },
        "install_dir": { "type": "string" },
        "package_name": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] },
        "installed_registry_path": { "type": ["string", "null"] },
        "installed_registry_sha256_actual": { "type": ["string", "null"] },
        "model_package_registry_path": { "type": ["string", "null"] },
        "model_package_registry_sha256": { "type": ["string", "null"] },
        "model_package_registry_entry": { "type": ["string", "null"] },
        "model_package_lock_path": { "type": ["string", "null"] },
        "model_package_lock_sha256": { "type": ["string", "null"] },
        "model_package_artifact_id": { "type": ["string", "null"] },
        "artifact_count": { "type": "integer", "minimum": 0 },
        "conformance_check_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "repair_yaml_command": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "yaml_repair": {
      "type": "object",
      "required": [
        "report",
        "result",
        "finding",
        "mode",
        "original_project",
        "repaired_project",
        "original_report",
        "repaired_report",
        "proposed",
        "selected",
        "applied",
        "blocked",
        "skipped",
        "original_matching_findings",
        "repaired_matching_findings",
        "original_matching_criticals",
        "repaired_matching_criticals",
        "new_criticals",
        "original_finding_removed",
        "no_new_criticals",
        "reason_codes"
      ],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "dry_run"] },
        "finding": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["apply", "dry_run", "apply_report"] },
        "original_project": { "type": "string", "minLength": 1 },
        "repaired_project": { "type": ["string", "null"] },
        "original_report": { "type": "string", "minLength": 1 },
        "repaired_report": { "type": ["string", "null"] },
        "proposed": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "applied": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "original_matching_findings": { "type": "integer", "minimum": 0 },
        "repaired_matching_findings": { "type": "integer", "minimum": 0 },
        "original_matching_criticals": { "type": "integer", "minimum": 0 },
        "repaired_matching_criticals": { "type": "integer", "minimum": 0 },
        "new_criticals": { "type": "integer", "minimum": 0 },
        "original_finding_removed": { "type": ["boolean", "null"] },
        "no_new_criticals": { "type": ["boolean", "null"] },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "model_package_bundle_import": {
      "type": "object",
      "required": [
        "report",
        "result",
        "bundle_path",
        "project",
        "profile",
        "install_dir",
        "package_name",
        "package_version",
        "bundle_install_report",
        "package_verification_report",
        "yaml_repair_report",
        "repaired_project",
        "repaired_validation_report",
        "model_package_registry_path",
        "model_package_registry_sha256",
        "model_package_registry_entry",
        "model_package_lock_path",
        "model_package_lock_sha256",
        "model_package_artifact_id",
        "bundle_artifacts",
        "conformance_checks",
        "package_findings",
