{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/manufacturing_metadata_import.schema.json",
  "title": "CircuitCI Manufacturing Metadata Import Manifest",
  "type": "object",
  "required": ["schema_version", "sources", "import", "rows"],
  "properties": {
    "schema_version": { "const": "0.5.0" },
    "sources": {
      "type": "object",
      "required": ["project", "metadata"],
      "properties": {
        "project": { "$ref": "#/$defs/source_file" },
        "metadata": { "$ref": "#/$defs/source_csv" }
      },
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "required": [
        "applied_fields",
        "skipped_rows",
        "allow_unknown_fields",
        "source_label"
      ],
      "properties": {
        "applied_fields": { "type": "integer", "minimum": 0 },
        "skipped_rows": { "type": "integer", "minimum": 0 },
        "allow_unknown_fields": { "type": "boolean" },
        "source_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "source_csv": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256", "columns", "data_rows"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_rows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "row_number",
        "raw_field",
        "status",
        "raw_value",
        "raw_columns"
      ],
      "properties": {
        "row_number": { "type": "integer", "minimum": 2 },
        "raw_field": { "type": "string", "minLength": 1 },
        "status": { "enum": ["applied", "skipped_unknown_field"] },
        "board_field": {
          "enum": [
            "stencil_thickness_mm",
            "min_drill_edge_clearance_mm",
            "min_slot_edge_clearance_mm",
            "min_paste_area_ratio",
            "max_paste_area_ratio",
            "min_solder_paste_spacing_mm",
            "max_stitch_via_distance_mm",
            "controlled_impedance.nets[]",
            "controlled_impedance.differential_pairs[]",
            "thermal_copper[]",
            "thermal_measurements[]",
            "layout.stackup.layers[]",
            "layout.constraints.rf_antenna.keepouts[]",
            "layout.constraints.rf_antenna.feed_paths[]",
            "source"
          ]
        },
        "raw_value": { "type": "string" },
        "normalized_value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": [
                "net",
                "source",
                "target_impedance_ohm",
                "expected_width_mm",
                "max_width_error_mm"
              ],
              "properties": {
                "net": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "target_impedance_ohm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expected_width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_width_error_mm": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "first_net",
                "second_net",
                "source",
                "target_differential_impedance_ohm",
                "expected_width_mm",
                "expected_gap_mm",
                "max_width_error_mm",
                "max_gap_error_mm"
              ],
              "properties": {
                "first_net": { "type": "string", "minLength": 1 },
                "second_net": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "target_differential_impedance_ohm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expected_width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expected_gap_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_width_error_mm": { "type": "number", "minimum": 0 },
                "max_gap_error_mm": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "component",
                "source",
                "measured_temperature_C"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "component": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "measured_temperature_C": { "type": "number" },
                "ambient_temperature_C": { "type": "number" },
                "measurement_uncertainty_C": { "type": "number", "minimum": 0 },
                "power_loss_w": { "type": "number", "exclusiveMinimum": 0 },
                "measurement_point": { "type": "string", "minLength": 1 },
                "notes": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "component",
                "source",
                "power_loss_w",
                "min_copper_area_mm2"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "component": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "power_loss_w": { "type": "number", "exclusiveMinimum": 0 },
                "min_copper_area_mm2": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "min_thermal_via_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_plated_thermal_via_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_thermal_via_drill_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "min_thermal_via_plating_thickness_um": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "min_total_thermal_via_barrel_cross_section_mm2": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "min_copper_thickness_um": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rated_ambient_temperature_C": { "type": "number" },
                "min_airflow_lfm": { "type": "number", "minimum": 0 },
                "enclosure_profile": { "type": "string", "minLength": 1 },
                "nets": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "layers": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["name", "kind", "source"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": {
                  "type": "string",
                  "enum": ["signal", "plane", "dielectric", "other"]
                },
                "reference_net": { "type": "string", "minLength": 1 },
                "thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
                "copper_thickness_um": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "dielectric_constant": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "material": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "layer",
                "polygon",
                "min_copper_clearance_mm",
                "source"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "antenna_net": { "type": "string", "minLength": 1 },
                "layer": { "type": "string", "minLength": 1 },
                "polygon": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "object",
                    "required": ["x_mm", "y_mm"],
                    "properties": {
                      "x_mm": { "type": "number" },
                      "y_mm": { "type": "number" }
                    },
                    "additionalProperties": false
                  }
                },
                "min_copper_clearance_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "antenna_net",
                "feed_component",
                "feed_pin",
                "max_feed_route_length_mm",
                "max_matching_component_distance_mm",
                "source"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "antenna_net": { "type": "string", "minLength": 1 },
                "feed_component": { "type": "string", "minLength": 1 },
                "feed_pin": { "type": "string", "minLength": 1 },
                "matching_components": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "max_feed_route_length_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "max_matching_component_distance_mm": {
                  "type": "number",
                  "minimum": 0
                },
                "source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 },
        "raw_columns": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
