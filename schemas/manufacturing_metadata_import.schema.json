{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/manufacturing_metadata_import.schema.json",
  "title": "CircuitCI Manufacturing Metadata Import Manifest",
  "type": "object",
  "required": ["schema_version", "sources", "import", "rows"],
  "properties": {
    "schema_version": { "const": "0.36.0" },
    "sources": {
      "type": "object",
      "required": ["project", "metadata"],
      "properties": {
        "project": { "$ref": "#/$defs/source_file" },
        "metadata": { "$ref": "#/$defs/source_csv" }
      },
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "required": [
        "applied_fields",
        "skipped_rows",
        "allow_unknown_fields",
        "source_label"
      ],
      "properties": {
        "applied_fields": { "type": "integer", "minimum": 0 },
        "skipped_rows": { "type": "integer", "minimum": 0 },
        "allow_unknown_fields": { "type": "boolean" },
        "source_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "source_csv": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256", "columns", "data_rows"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_rows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "row_number",
        "raw_field",
        "status",
        "raw_value",
        "raw_columns"
      ],
      "properties": {
        "row_number": { "type": "integer", "minimum": 2 },
        "raw_field": { "type": "string", "minLength": 1 },
        "status": { "enum": ["applied", "skipped_unknown_field"] },
        "board_field": {
          "enum": [
            "stencil_thickness_mm",
            "min_drill_edge_clearance_mm",
            "min_slot_edge_clearance_mm",
            "min_paste_area_ratio",
            "max_paste_area_ratio",
            "min_solder_paste_spacing_mm",
            "max_stitch_via_distance_mm",
            "controlled_impedance.nets[]",
            "controlled_impedance.differential_pairs[]",
            "controlled_impedance.coupons[]",
            "controlled_impedance.coupons[].samples[]",
            "controlled_impedance.solver_results[]",
            "controlled_impedance.solver_results[].samples[]",
            "controlled_impedance.solver_results[].material_corners[]",
            "controlled_impedance.solver_qualifications[]",
            "controlled_impedance.solver_material_libraries[]",
            "controlled_impedance.solver_material_acceptances[]",
            "controlled_impedance.solver_material_processes[]",
            "controlled_impedance.solver_runtime_allowlists[]",
            "controlled_impedance.solver_entitlements[]",
            "controlled_impedance.solver_execution_environments[]",
            "thermal_copper[]",
            "thermal_measurements[]",
            "thermal_packages[]",
            "thermal_environments[]",
            "thermal_limits[]",
            "layout.stackup.layers[]",
            "layout.constraints.rf_antenna.keepouts[]",
            "layout.constraints.rf_antenna.feed_paths[]",
            "layout.constraints.rf_antenna.matching_networks[]",
            "layout.constraints.rf_antenna.measurements[]",
            "layout.constraints.rf_antenna.performance_limits[]",
            "layout.constraints.rf_antenna.measurement_conditions[]",
            "source"
          ]
        },
        "raw_value": { "type": "string" },
        "normalized_value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": [
                "net",
                "source",
                "target_impedance_ohm",
                "expected_width_mm",
                "max_width_error_mm"
              ],
              "properties": {
                "net": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "target_impedance_ohm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expected_width_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_width_error_mm": { "type": "number", "minimum": 0 },
                "solder_mask_state": { "enum": ["covered", "opened"] },
                "solder_mask_layer": { "type": "string", "minLength": 1 },
                "solder_mask_source": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "source",
                "solver",
                "solver_version",
                "environment_id",
                "environment_revision",
                "artifact_uri",
                "artifact_sha256",
                "reproducibility_fingerprint",
                "locked_components"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "solver": { "type": "string", "minLength": 1 },
                "solver_version": { "type": "string", "minLength": 1 },
                "environment_id": { "type": "string", "minLength": 1 },
                "environment_revision": { "type": "string", "minLength": 1 },
                "artifact_uri": { "type": "string", "minLength": 1 },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "reproducibility_fingerprint": {
                  "type": "string",
                  "minLength": 1
                },
                "locked_components": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "name",
                "source",
                "solver",
                "solver_version",
                "entitlement_id",
                "entitlement_revision",
                "artifact_uri",
                "artifact_sha256",
                "licensed_features"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "solver": { "type": "string", "minLength": 1 },
                "solver_version": { "type": "string", "minLength": 1 },
                "entitlement_id": { "type": "string", "minLength": 1 },
                "entitlement_revision": { "type": "string", "minLength": 1 },
