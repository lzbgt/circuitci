{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/model_package_lock.schema.json",
  "title": "CircuitCI Compact Model Package Lock",
  "type": "object",
  "required": ["package", "artifacts"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "artifact_format"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "artifact_format": {
            "enum": ["spice_include", "osdi_shared_object", "xyce_adms_plugin"]
          },
          "compiler": { "enum": ["openvaf", "xyce_adms"] },
          "source_path": { "type": "string", "minLength": 1 },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "conformance_artifact": { "type": "string", "minLength": 1 },
          "conformance_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
