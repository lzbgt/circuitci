{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/model_package_bundle_manifest.schema.json",
  "title": "CircuitCI Compact Model Package Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "lock_path",
    "lock_sha256",
    "registry_path",
    "registry_sha256",
    "verification_report",
    "verification_markdown",
    "readme",
    "artifacts",
    "conformance_checks"
  ],
  "properties": {
    "schema_version": { "const": "circuitci.model_package_bundle.v1" },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lock_path": { "type": "string", "minLength": 1 },
    "lock_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "registry_path": { "type": ["string", "null"] },
    "registry_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "verification_report": { "type": "string", "minLength": 1 },
    "verification_markdown": { "type": "string", "minLength": 1 },
    "readme": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact_path",
          "artifact_sha256",
          "artifact_format",
          "compiler"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "artifact_format": { "type": "string", "minLength": 1 },
          "compiler": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "conformance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_artifact_id",
          "report_path",
          "target_artifact_id",
          "target_artifact_sha256",
          "check_name",
          "analysis",
          "solver",
          "result",
          "artifacts"
        ],
        "properties": {
          "report_artifact_id": { "type": "string", "minLength": 1 },
          "report_path": { "type": "string", "minLength": 1 },
          "target_artifact_id": { "type": ["string", "null"] },
          "target_artifact_sha256": { "type": ["string", "null"] },
          "check_name": { "type": ["string", "null"] },
          "analysis": { "type": ["string", "null"] },
          "solver": { "type": ["string", "null"] },
          "result": { "type": ["string", "null"] },
          "artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
