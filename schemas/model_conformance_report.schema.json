{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitci.local/schemas/model_conformance_report.schema.json",
  "title": "CircuitCI Compact Model Conformance Report",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "artifact_id",
    "runtime_artifact_sha256",
    "result",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "circuitci.model_conformance_report.v1" },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact_id": { "type": "string", "minLength": 1 },
    "runtime_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "result": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "analysis", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "analysis": { "type": "string", "minLength": 1 },
          "solver": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail"] },
          "measured": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "string", "boolean", "null"]
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "string", "boolean", "null"]
            }
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
