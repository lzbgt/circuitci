* Generic behavioral analog macro-models for preliminary CircuitCI design simulation.
* These models are intentionally simple and are not vendor- or bench-calibrated.

.subckt CIRCUITCI_IDEAL_OPAMP INP INN VCC VEE OUT
* Finite-gain voltage-controlled source for preliminary closed-loop topology checks.
EGAIN NRAW VEE INP INN 100000
ROUT NRAW OUT 10
RBIASP INP VEE 1G
RBIASN INN VEE 1G
COUT OUT VEE 10p
.ends CIRCUITCI_IDEAL_OPAMP

.subckt CIRCUITCI_IDEAL_COMPARATOR INP INN VCC VEE OUT
* Logistic transition avoids the convergence problems of a hard digital step.
BOUT OUT VEE V={v(VCC,VEE)/(1+exp(-1000*(v(INP)-v(INN))))}
ROUT OUT VEE 1G
.ends CIRCUITCI_IDEAL_COMPARATOR

.subckt CIRCUITCI_IDEAL_LDO_3V3 VIN EN GND VOUT
* Idealized enabled 3.3 V source with smooth enable behavior.
BOUT VOUT GND V={3.3/(1+exp(-20*(v(EN,GND)-1)))}
ROUT VOUT GND 1G
.ends CIRCUITCI_IDEAL_LDO_3V3

.subckt CIRCUITCI_AMS1117_3V3_LDO VIN GND VOUT
* Reduced AMS1117-3.3 fixed-LDO observation behavior.
* VOUT is an ideal preliminary 3.3 V rail while VIN exceeds the datasheet
* 3.3 V output plus 1.3 V maximum dropout margin. Minimum load, output
* capacitance, current limit, thermal behavior, loop stability, PSRR, noise,
* and startup timing are represented by Board IR metadata and checks, not by
* this transient source.
BOUT VOUT GND V={3.3/(1+exp(-20*(v(VIN,GND)-4.6)))}
ROUT VOUT GND 1G
.ends CIRCUITCI_AMS1117_3V3_LDO

.subckt CIRCUITCI_CH340C_USB_UART VCC GND TXD RXD DTR_N RTS_N PARAMS: TXD_STATE=1 DTR_N_STATE=1 RTS_N_STATE=1
* Reduced CH340C USB-UART bridge observation behavior.
* TXD, DTR_N, and RTS_N are preliminary voltage drivers with the source
* impedance inferred from the 3.3 V-mode VOH condition. RXD is represented as a
* high-impedance input. USB protocol, enumeration, oscillator, suspend, and
* transistor-level modem-line behavior are intentionally not modeled.
BTXD NTXD GND V={v(VCC,GND)*TXD_STATE}
RTXD NTXD TXD 300
BDTR NDTR GND V={v(VCC,GND)*DTR_N_STATE}
RDTR NDTR DTR_N 300
BRTS NRTS GND V={v(VCC,GND)*RTS_N_STATE}
RRTS NRTS RTS_N 300
RRXD RXD GND 1G
.ends CIRCUITCI_CH340C_USB_UART

.subckt CIRCUITCI_CP2102N_USB_UART VREGIN VDD VIO GND TXD RXD RTS DTR RSTB PARAMS: TXD_STATE=1 RTS_STATE=1 DTR_STATE=1
* Reduced CP2102N USB-UART bridge observation behavior.
* VDD is a preliminary internal-regulator rail from VREGIN. TXD, RTS, and DTR
* are VIO-referenced voltage drivers with conservative source impedance. RXD
* and RSTB are represented as high-impedance inputs. USB protocol,
* enumeration, UART timing, suspend, regulator stability, and transistor-level
* modem-line behavior are intentionally not modeled.
BREG NREG GND V={3.3/(1+exp(-4*(v(VREGIN,GND)-3.0)))}
RREG NREG VDD 0.1
BTXD NTXD GND V={v(VIO,GND)*TXD_STATE}
RTXD NTXD TXD 100
BRTS NRTS GND V={v(VIO,GND)*RTS_STATE}
RRTS NRTS RTS 100
BDTR NDTR GND V={v(VIO,GND)*DTR_STATE}
RDTR NDTR DTR 100
RRXD RXD GND 1G
RRST RSTB GND 1G
.ends CIRCUITCI_CP2102N_USB_UART

.subckt CIRCUITCI_FT232R_USB_UART VCC V3V3OUT VCCIO GND TXD RXD RTS_N DTR_N RESET_N PARAMS: TXD_STATE=1 RTS_N_STATE=1 DTR_N_STATE=1
* Reduced FT232R USB-UART bridge observation behavior.
* V3V3OUT is a preliminary internal-regulator rail from VCC. TXD, RTS_N, and
* DTR_N are VCCIO-referenced voltage drivers with conservative source
* impedance. RXD and RESET_N are represented as high-impedance inputs. USB
* protocol, enumeration, EEPROM/CBUS programming, suspend, oscillator accuracy,
* regulator stability, and transistor-level modem-line behavior are
* intentionally not modeled.
BREG NREG GND V={3.3/(1+exp(-4*(v(VCC,GND)-4.0)))}
RREG NREG V3V3OUT 0.1
BTXD NTXD GND V={v(VCCIO,GND)*TXD_STATE}
RTXD NTXD TXD 1100
BRTS NRTS GND V={v(VCCIO,GND)*RTS_N_STATE}
RRTS NRTS RTS_N 1100
BDTR NDTR GND V={v(VCCIO,GND)*DTR_N_STATE}
RDTR NDTR DTR_N 1100
RRXD RXD GND 1G
RRST RESET_N GND 1G
.ends CIRCUITCI_FT232R_USB_UART

.subckt CIRCUITCI_CH347_USB_JTAG_BRIDGE VCC GND TXD1 RXD1 TMS TCK TDI TDO TRST PARAMS: TXD1_STATE=1 TMS_STATE=1 TCK_STATE=0 TDI_STATE=1 TRST_STATE=1
* Reduced CH347 USB-JTAG bridge observation behavior.
* TXD1, TMS, TCK, TDI, and TRST are preliminary VCC-referenced voltage
* drivers with source impedance inferred from the 3.3 V VOH condition. RXD1
* and TDO are represented as high-impedance inputs. USB protocol,
* enumeration, UART/JTAG timing, clocking, EEPROM configuration, and
* protocol-level TAP behavior are intentionally not modeled.
BTXD1 NTXD1 GND V={v(VCC,GND)*TXD1_STATE}
RTXD1 NTXD1 TXD1 50
BTMS NTMS GND V={v(VCC,GND)*TMS_STATE}
RTMS NTMS TMS 50
BTCK NTCK GND V={v(VCC,GND)*TCK_STATE}
RTCK NTCK TCK 50
BTDI NTDI GND V={v(VCC,GND)*TDI_STATE}
RTDI NTDI TDI 50
BTRST NTRST GND V={v(VCC,GND)*TRST_STATE}
RTRST NTRST TRST 50
RRXD1 RXD1 GND 1G
RTDO TDO GND 1G
.ends CIRCUITCI_CH347_USB_JTAG_BRIDGE

.subckt CIRCUITCI_CMSIS_DAP_SWD_PROBE VTREF GND SWCLK SWDIO NRESET SWO PARAMS: SWCLK_STATE=1 SWDIO_STATE=1 NRESET_ASSERT=0
* Reduced CMSIS-DAP SWD probe observation behavior.
* SWCLK and SWDIO are preliminary VTREF-referenced push-pull line-state
* drivers. NRESET is represented as an open-drain-style pull-down that releases
* to the target pull-up when NRESET_ASSERT is low. SWO is represented as a
* high-impedance input. USB transport, CMSIS-DAP command sequencing, turnaround
* timing, SWD protocol transfers, and target/probe vendor electrical limits are
* intentionally not modeled.
BSWCLK NSWCLK GND V={v(VTREF,GND)*SWCLK_STATE}
RSWCLK NSWCLK SWCLK 100
BSWDIO NSWDIO GND V={v(VTREF,GND)*SWDIO_STATE}
RSWDIO NSWDIO SWDIO 100
BNRST NNRST GND V={0}
RNRST NNRST NRESET {1e12/(1+1e9*NRESET_ASSERT)}
RSWO SWO GND 1G
.ends CIRCUITCI_CMSIS_DAP_SWD_PROBE

.subckt CIRCUITCI_ESP32_S3_WROOM_BOOT_USB VDD GND EN IO0 IO46 IO19 IO20 TXD0 RXD0 PARAMS: EN_STATE=1 IO0_STATE=1 IO46_STATE=0 USB_DM_STATE=0 USB_DP_STATE=1 TXD0_STATE=1
* Reduced ESP32-S3-WROOM boot/USB observation behavior.
* VDD, EN, GPIO0/GPIO46 boot straps, USB D-/D+ identification pins, and TXD0
* idle state are represented as preliminary board-facing line states. RF,
* firmware execution, ROM boot protocol, USB PHY eye/impedance behavior,
* flash/PSRAM mux safety, current peaks, and thermal behavior are intentionally
* not modeled.
BEN NEN GND V={v(VDD,GND)*EN_STATE}
REN NEN EN 1000
BIO0 NIO0 GND V={v(VDD,GND)*IO0_STATE}
RIO0 NIO0 IO0 10000
BIO46 NIO46 GND V={v(VDD,GND)*IO46_STATE}
RIO46 NIO46 IO46 10000
BIO19 NIO19 GND V={v(VDD,GND)*USB_DM_STATE}
RIO19 NIO19 IO19 1000
BIO20 NIO20 GND V={v(VDD,GND)*USB_DP_STATE}
RIO20 NIO20 IO20 1000
BTXD0 NTXD0 GND V={2.64*TXD0_STATE}
RTXD0 NTXD0 TXD0 82.5
RRXD0 RXD0 GND 1G
RVDD VDD GND 1G
.ends CIRCUITCI_ESP32_S3_WROOM_BOOT_USB

.subckt CIRCUITCI_ESP32_WROOM_32E_BOOT_UART VDD GND EN IO0 IO2 TXD0 RXD0 PARAMS: EN_STATE=1 IO0_STATE=1 IO2_STATE=0 TXD0_STATE=1
* Reduced ESP32-WROOM-32E boot/UART observation behavior.
* VDD, EN, GPIO0/GPIO2 boot straps, and TXD0 idle state are represented as
* preliminary board-facing line states. RF, firmware execution, ROM serial
* protocol, flash/PSRAM mux safety, current peaks, and thermal behavior are
* intentionally not modeled.
BEN NEN GND V={v(VDD,GND)*EN_STATE}
REN NEN EN 1000
BIO0 NIO0 GND V={v(VDD,GND)*IO0_STATE}
RIO0 NIO0 IO0 10000
BIO2 NIO2 GND V={v(VDD,GND)*IO2_STATE}
RIO2 NIO2 IO2 10000
BTXD0 NTXD0 GND V={2.64*TXD0_STATE}
RTXD0 NTXD0 TXD0 82.5
RRXD0 RXD0 GND 1G
RVDD VDD GND 1G
.ends CIRCUITCI_ESP32_WROOM_32E_BOOT_UART

.subckt CIRCUITCI_TXS0108E_A_TO_B_LEVEL_SHIFTER VCCA VCCB GND OE A1 B1
* Reduced TXS0108E level-shifter observation behavior.
* This face models only enabled A1-to-B1 high/low translation for preliminary
* mixed-voltage checks. Automatic bidirectional sensing, edge accelerators,
* pull-up sizing, capacitive loading, partial-power behavior, timing, and signal
* integrity are intentionally not modeled.
BOUT NB1 GND V={v(VCCB,GND)/(1+exp(-20*(v(OE,GND)-0.5*v(VCCA,GND))))/(1+exp(-20*(v(A1,GND)-0.5*v(VCCA,GND))))}
RBOUT NB1 B1 200
RAIN A1 GND 1G
ROE OE GND 1G
.ends CIRCUITCI_TXS0108E_A_TO_B_LEVEL_SHIFTER

.subckt CIRCUITCI_TPD2EUSB30_USB_ESD DP DM GND
* Reduced TPD2EUSB30 USB ESD observation behavior.
* Normal-operation model only: 0.7 pF typical IO-to-ground capacitance and
* high-impedance leakage placeholders. IEC ESD pulse clamping, dynamic snapback,
* leakage over temperature, USB eye margin, and layout are intentionally not
* modeled.
CDP DP GND 0.7p
CDM DM GND 0.7p
RDP DP GND 1G
RDM DM GND 1G
.ends CIRCUITCI_TPD2EUSB30_USB_ESD

.subckt CIRCUITCI_PRTR5V0U2X_USB_ESD IO1 IO2 VCC GND
* Reduced PRTR5V0U2X rail-to-rail USB ESD observation behavior.
* Normal-operation model only: datasheet capacitance loads and high-impedance
* leakage placeholders. IEC ESD pulse clamping, rail-to-rail snapback dynamics,
* leakage over temperature, USB eye margin, differential impedance, and layout
* are intentionally not modeled.
CIO1 IO1 GND 1.5p
CIO2 IO2 GND 1.5p
CIO12 IO1 IO2 0.6p
CVCC VCC GND 16p
RIO1 IO1 GND 1G
RIO2 IO2 GND 1G
.ends CIRCUITCI_PRTR5V0U2X_USB_ESD

.subckt CIRCUITCI_ESD2CAN24_Q1_CAN_ESD CANH CANL GND
* Reduced ESD2CAN24-Q1 CAN ESD observation behavior.
* Normal-operation model only: 3 pF typical IO capacitance loads and
* high-impedance leakage placeholders. ISO transients, ESD pulse clamping,
* surge energy, CAN signal integrity, harness behavior, and layout/stub effects
* are intentionally not modeled.
CCANH CANH GND 3p
CCANL CANL GND 3p
RCANH CANH GND 1G
RCANL CANL GND 1G
.ends CIRCUITCI_ESD2CAN24_Q1_CAN_ESD

.subckt CIRCUITCI_ESDS552_RS485_ESD A B GND
* Reduced ESDS552 RS-485/RS-422 ESD/surge observation behavior.
* Normal-operation model only: 11 pF maximum IO-to-ground capacitance loads and
* high-impedance leakage placeholders. IEC ESD/surge pulse clamping, surge
* response, RS-485 common-mode stress, termination, cable harness behavior, and
* signal integrity are intentionally not modeled.
CA A GND 11p
CB B GND 11p
RA A GND 1G
RB B GND 1G
.ends CIRCUITCI_ESDS552_RS485_ESD

.subckt CIRCUITCI_THVD1450_RS485_TRANSCEIVER VCC GND DI RO DE RE_N A B PARAMS: DI_STATE=1 DE_STATE=1 RE_N_STATE=0
* Reduced THVD1450 RS-485 transceiver observation behavior.
* Normal-operation line-state model only: datasheet-backed pin roles and logic
* thresholds are represented by parameterized DI/DE/RE_N states with simple
* VCC-referenced A/B and RO levels. Termination, failsafe bias, common-mode
* range, cable behavior, ESD/fault stress, timing, and signal integrity are
* intentionally not modeled.
BDI NDI GND V={v(VCC,GND)*DI_STATE}
RDI NDI DI 1k
BDE NDE GND V={v(VCC,GND)*DE_STATE}
RDE NDE DE 1k
BRE NRE GND V={v(VCC,GND)*RE_N_STATE}
RRE NRE RE_N 1k
BA NA GND V={v(VCC,GND)*(0.25+0.5*DI_STATE)}
RA NA A {200+1e12*(1-DE_STATE)}
BB NB GND V={v(VCC,GND)*(0.75-0.5*DI_STATE)}
RB NB B {200+1e12*(1-DE_STATE)}
BRO NRO GND V={v(VCC,GND)/(1+exp(-8*(v(A,GND)-v(B,GND))))/(1+exp(-20*(0.5*v(VCC,GND)-v(RE_N,GND))))}
RRO NRO RO 50
RDI_BIAS DI GND 1G
RDE_BIAS DE GND 1G
RRE_BIAS RE_N GND 1G
RRO_BIAS RO GND 1G
.ends CIRCUITCI_THVD1450_RS485_TRANSCEIVER

.subckt CIRCUITCI_TCAN3413_CAN_TRANSCEIVER VCC VIO GND TXD RXD STB CANH CANL PARAMS: TXD_STATE=0 STB_STATE=0
* Reduced TCAN3413 CAN transceiver observation behavior.
* Normal-operation line-state model only: datasheet-backed pin roles and logic
* thresholds are represented by parameterized TXD/STB states with simple
* VCC/VIO-referenced CANH/CANL and RXD levels. CAN termination, common-mode
* range, cable behavior, CAN FD timing, fault stress, EMC, and signal
* integrity are intentionally not modeled.
BTXD NTXD GND V={v(VIO,GND)*TXD_STATE}
RTXD NTXD TXD 1k
BSTB NSTB GND V={v(VIO,GND)*STB_STATE}
RSTB NSTB STB 1k
BCANH NH GND V={v(VCC,GND)*(0.5+0.25*(1-TXD_STATE)*(1-STB_STATE))}
RCANH NH CANH 200
BCANL NL GND V={v(VCC,GND)*(0.5-0.25*(1-TXD_STATE)*(1-STB_STATE))}
RCANL NL CANL 200
BRXD NRXD GND V={v(VIO,GND)*(TXD_STATE+(1-TXD_STATE)*STB_STATE)}
RRXD NRXD RXD 50
RTXD_BIAS TXD GND 1G
RSTB_BIAS STB GND 1G
RRXD_BIAS RXD GND 1G
.ends CIRCUITCI_TCAN3413_CAN_TRANSCEIVER

.subckt CIRCUITCI_DRV8323_GATE_DRIVER VM DVDD GND ENABLE NFAULT SDO SOA SOB SOC PARAMS: NFAULT_STATE=1 SDO_STATE=0 SOA_V=1.65 SOB_V=1.65 SOC_V=1.65
* Reduced DRV8323 three-phase smart gate-driver observation behavior.
* Board-facing supply/control and observation-node model only: VM/DVDD,
* ENABLE, nFAULT, SDO, and nominal current-sense output presence are
* represented with source-backed limits and explicit state parameters.
* Half-bridge gate-drive strength, MOSFET charge/dead-time, charge pump,
* bootstrap behavior, SPI register/protection behavior, shunt gain/offset/noise,
* motor dynamics, layout, and thermal sign-off are intentionally not modeled.
BOK NOK GND V={1/(1+exp(-20*(v(ENABLE,GND)-2.0)))/(1+exp(-4*(v(VM,GND)-6.0)))}
BNFAULT NNFAULT GND V={3.3*NFAULT_STATE*v(NOK,GND)}
RNFAULT NNFAULT NFAULT 1k
BSDO NSDO GND V={3.3*SDO_STATE*v(NOK,GND)}
RSDO NSDO SDO 50
BSOA SOA GND V={SOA_V*v(NOK,GND)}
BSOB SOB GND V={SOB_V*v(NOK,GND)}
BSOC SOC GND V={SOC_V*v(NOK,GND)}
RVM VM GND 1G
RDVDD DVDD GND 1G
RENABLE ENABLE GND 1G
RNFAULT_BIAS NFAULT GND 1G
RSDO_BIAS SDO GND 1G
.ends CIRCUITCI_DRV8323_GATE_DRIVER

.subckt CIRCUITCI_PCA9685_PWM_DRIVER VDD VSS OE SCL SDA PWM0 PWM1 PWM2 PWM3 PARAMS: PWM_HIGH_V=3.3 PWM_FREQ_HZ=50 PWM0_DUTY_PERCENT=7.5 PWM1_DUTY_PERCENT=7.5 PWM2_DUTY_PERCENT=7.5 PWM3_DUTY_PERCENT=7.5 SCL_STATE=1 SDA_STATE=1
* Reduced PCA9685 16-channel I2C PWM driver observation behavior.
* Board-facing low-load model only: VDD/VSS, active-low OE, idle I2C
* logic states, and four representative PWM outputs are represented with
* explicit frequency/duty parameters. I2C protocol/registers, oscillator
* tolerance, phase staggering, output current/thermal behavior, LED/servo
* loading, and high-Z disabled-output behavior are intentionally not modeled.
BI2CSCL NSCL VSS V={PWM_HIGH_V*SCL_STATE}
RI2CSCL NSCL SCL 50
BI2CSDA NSDA VSS V={PWM_HIGH_V*SDA_STATE}
RI2CSDA NSDA SDA 50
VO0 NRAW0 VSS PULSE(0 {PWM_HIGH_V} 0 1u 1u {PWM0_DUTY_PERCENT/100/PWM_FREQ_HZ} {1/PWM_FREQ_HZ})
BPWM0 N0 VSS V={v(NRAW0,VSS)/(1+exp(20*(v(OE,VSS)-0.8)))}
RPWM0 N0 PWM0 330
VO1 NRAW1 VSS PULSE(0 {PWM_HIGH_V} 0 1u 1u {PWM1_DUTY_PERCENT/100/PWM_FREQ_HZ} {1/PWM_FREQ_HZ})
BPWM1 N1 VSS V={v(NRAW1,VSS)/(1+exp(20*(v(OE,VSS)-0.8)))}
RPWM1 N1 PWM1 330
VO2 NRAW2 VSS PULSE(0 {PWM_HIGH_V} 0 1u 1u {PWM2_DUTY_PERCENT/100/PWM_FREQ_HZ} {1/PWM_FREQ_HZ})
BPWM2 N2 VSS V={v(NRAW2,VSS)/(1+exp(20*(v(OE,VSS)-0.8)))}
RPWM2 N2 PWM2 330
VO3 NRAW3 VSS PULSE(0 {PWM_HIGH_V} 0 1u 1u {PWM3_DUTY_PERCENT/100/PWM_FREQ_HZ} {1/PWM_FREQ_HZ})
BPWM3 N3 VSS V={v(NRAW3,VSS)/(1+exp(20*(v(OE,VSS)-0.8)))}
RPWM3 N3 PWM3 330
RVDD VDD VSS 1G
ROE OE VSS 1G
.ends CIRCUITCI_PCA9685_PWM_DRIVER

.subckt CIRCUITCI_ICM42688P_SPI_IMU VDD VDDIO GND SCLK SDI SDO CS INT1 PARAMS: SDO_STATE=0 INT1_STATE=1
* Reduced ICM-42688-P SPI IMU observation behavior.
* VDD/VDDIO, high-impedance SPI inputs, and SDO/INT1 output states are
* represented for preliminary board-facing rail and line-state checks. Sensor
* dynamics, register protocol, sampling, FIFO behavior, noise, bias stability,
* vibration, and layout coupling are intentionally not modeled.
BSDO NSDO GND V={v(VDDIO,GND)*SDO_STATE}
RSDO NSDO SDO 80
BINT1 NINT1 GND V={v(VDDIO,GND)*INT1_STATE}
RINT1 NINT1 INT1 80
RVDD VDD GND 1G
RVDDIO VDDIO GND 1G
RSCLK SCLK GND 1G
RSDI SDI GND 1G
RCS CS GND 1G
.ends CIRCUITCI_ICM42688P_SPI_IMU

.subckt CIRCUITCI_LICHEERV_NANO_W_MODULE V5 GND UART0_TX UART0_RX MOTION_EN FAULT_IRQ PARAMS: UART0_TX_STATE=1 MOTION_EN_STATE=1
* Reduced LicheeRV-Nano-W module observation behavior.
* The 5 V module rail, UART0 TX output, motion-enable GPIO output, and
* high-impedance UART0 RX / fault-IRQ inputs are represented for preliminary
* board-facing rail and line-state checks. Linux boot power transients, SoC
* internal rails, MIPI/USB/high-speed behavior, firmware, and exact header
* numbering are intentionally not modeled.
BTX NTX GND V={3.3*UART0_TX_STATE}
RTX NTX UART0_TX 50
BMOTION NMOTION GND V={3.3*MOTION_EN_STATE}
RMOTION NMOTION MOTION_EN 50
RV5 V5 GND 1G
RRX UART0_RX GND 1G
RFAULT FAULT_IRQ GND 1G
.ends CIRCUITCI_LICHEERV_NANO_W_MODULE

.subckt CIRCUITCI_AT32F435_MOTION_CORE_MCU VDD GND LRV_UART_RX LRV_UART_TX LRV_MOTION_EN MOTION_FAULT_IRQ CAN_TX CAN_RX RS485_TX RS485_RX RS485_DE SERVO_PWM_OE PARAMS: LRV_UART_TX_STATE=1 MOTION_FAULT_IRQ_STATE=0 CAN_TX_STATE=1 RS485_TX_STATE=1 RS485_DE_STATE=0 SERVO_PWM_OE_STATE=1
* Reduced AT32F435 motion-core MCU observation behavior.
* VDD, high-impedance board-facing control inputs, and explicit static output
* states are represented for preliminary rail and low-speed interface checks.
* Firmware, reset/clock timing, CAN/RS485 protocol timing, ADC/motor-control
* loops, package pin assignment, and layout/SI behavior are intentionally not
* modeled.
BLRVT NLRVT GND V={3.3*LRV_UART_TX_STATE}
RLRVT NLRVT LRV_UART_TX 50
BMFAULT NMFAULT GND V={3.3*MOTION_FAULT_IRQ_STATE}
RMFAULT NMFAULT MOTION_FAULT_IRQ 50
BCANT NCANT GND V={3.3*CAN_TX_STATE}
RCANT NCANT CAN_TX 50
BRS485T NRS485T GND V={3.3*RS485_TX_STATE}
RRS485T NRS485T RS485_TX 50
BRS485DE NRS485DE GND V={3.3*RS485_DE_STATE}
RRS485DE NRS485DE RS485_DE 50
BSERVO NSERVO GND V={3.3*SERVO_PWM_OE_STATE}
RSERVO NSERVO SERVO_PWM_OE 50
RVDD VDD GND 1G
RLRVR LRV_UART_RX GND 1G
RMOTIONEN LRV_MOTION_EN GND 1G
RCANR CAN_RX GND 1G
RRS485R RS485_RX GND 1G
.ends CIRCUITCI_AT32F435_MOTION_CORE_MCU

.subckt CIRCUITCI_AT32M416_MOTOR_CONTROL_MCU VDD GND CAN_TX CAN_RX PWM_UH PWM_UL PWM_VH PWM_VL PWM_WH PWM_WL DRV_EN DRV_NFAULT DRV_SPI_SCK DRV_SPI_MOSI DRV_SPI_MISO DRV_SPI_CS CUR_U CUR_V CUR_W ENC_A ENC_B ENC_Z ENABLE_IN FAULT_OUT PARAMS: CAN_TX_STATE=1 PWM_UH_STATE=1 PWM_UL_STATE=0 PWM_VH_STATE=0 PWM_VL_STATE=1 PWM_WH_STATE=0 PWM_WL_STATE=0 DRV_EN_STATE=1 DRV_SPI_SCK_STATE=0 DRV_SPI_MOSI_STATE=0 DRV_SPI_CS_STATE=1 FAULT_OUT_STATE=0
* Reduced AT32M416 motor-control MCU observation behavior.
* VDD, high-impedance driver/encoder/control inputs, current-sense pins, and
* explicit static CAN/PWM/SPI/enable/fault output states are represented for
* preliminary rail and low-speed driver-interface checks. Firmware, timer
* waveforms, ADC sampling, FOC loops, dead-time, package pin assignment,
* gate-drive physics, layout/SI, and thermal behavior are intentionally not
* modeled.
BCANT NCANT GND V={3.3*CAN_TX_STATE}
RCANT NCANT CAN_TX 50
BPUH NPUH GND V={3.3*PWM_UH_STATE}
RPUH NPUH PWM_UH 50
BPUL NPUL GND V={3.3*PWM_UL_STATE}
RPUL NPUL PWM_UL 50
BPVH NPVH GND V={3.3*PWM_VH_STATE}
RPVH NPVH PWM_VH 50
BPVL NPVL GND V={3.3*PWM_VL_STATE}
RPVL NPVL PWM_VL 50
BPWH NPWH GND V={3.3*PWM_WH_STATE}
RPWH NPWH PWM_WH 50
BPWL NPWL GND V={3.3*PWM_WL_STATE}
RPWL NPWL PWM_WL 50
BDRVEN NDRV GND V={3.3*DRV_EN_STATE}
RDRVEN NDRV DRV_EN 50
BSCK NSCK GND V={3.3*DRV_SPI_SCK_STATE}
RSCK NSCK DRV_SPI_SCK 50
BMOSI NMOSI GND V={3.3*DRV_SPI_MOSI_STATE}
RMOSI NMOSI DRV_SPI_MOSI 50
BCS NCS GND V={3.3*DRV_SPI_CS_STATE}
RCS NCS DRV_SPI_CS 50
BFAULT NFAULT GND V={3.3*FAULT_OUT_STATE}
RFAULT NFAULT FAULT_OUT 50
RVDD VDD GND 1G
RCANR CAN_RX GND 1G
RDRVFAULT DRV_NFAULT GND 1G
RMISO DRV_SPI_MISO GND 1G
RCURU CUR_U GND 1G
RCURV CUR_V GND 1G
RCURW CUR_W GND 1G
RENCA ENC_A GND 1G
RENCB ENC_B GND 1G
RENCZ ENC_Z GND 1G
RENABLE ENABLE_IN GND 1G
.ends CIRCUITCI_AT32M416_MOTOR_CONTROL_MCU

.subckt CIRCUITCI_STM32L431_BOOT_UART_SWD_MCU VDD VSS NRST BOOT0 PA9 PA10 PA13 PA14 PARAMS: PA9_STATE=1 PA13_STATE=1
* Reduced STM32L431 boot/UART/SWD observation behavior.
* VDD, reset/BOOT0 inputs, USART1 PA9/PA10, and SWD PA13/PA14 are represented
* for preliminary board-boundary checks. Firmware execution, oscillators, ROM
* bootloader protocol timing, SWD transactions, flash side effects, complete
* package pin mapping, layout/SI, EMC, and thermal behavior are intentionally
* not modeled.
BPA9 NPA9 VSS V={3.3*PA9_STATE}
RPA9 NPA9 PA9 50
BPA13 NPA13 VSS V={3.3*PA13_STATE}
RPA13 NPA13 PA13 50
RVDD VDD VSS 1G
RNRST NRST VSS 1G
RBOOT BOOT0 VSS 1G
RPA10 PA10 VSS 1G
RPA14 PA14 VSS 1G
.ends CIRCUITCI_STM32L431_BOOT_UART_SWD_MCU

.subckt CIRCUITCI_TPS54331_5V_BUCK VIN EN GND VSENSE PARAMS: VOUT_V=5
* Reduced TPS54331 5 V buck-regulator observation behavior.
* The output is an ideal preliminary rail source gated by VIN input range and
* EN. Switching action, PH/BOOT behavior, compensation, ripple, current limit,
* thermal behavior, and Eco-mode are intentionally not modeled.
BOUT VSENSE GND V={VOUT_V/(1+exp(-4*(v(VIN,GND)-3.5)))/(1+exp(-20*(v(EN,GND)-1)))}
ROUT VSENSE GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS54331_5V_BUCK

.subckt CIRCUITCI_TPS62162_3V3_BUCK VIN EN GND VOS PARAMS: VOUT_V=3.3
* Reduced TPS62162 3.3 V buck-regulator observation behavior.
* The output is an ideal preliminary rail source gated by the datasheet VIN
* operating floor and EN. SW/PG behavior, DCS-Control dynamics, ripple, current
* limit, thermal behavior, layout, EMI, and loop stability are intentionally
* not modeled.
BOUT VOS GND V={VOUT_V/(1+exp(-4*(v(VIN,GND)-3.0)))/(1+exp(-20*(v(EN,GND)-1)))}
ROUT VOS GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS62162_3V3_BUCK

.subckt CIRCUITCI_TPS63802_3V3_BUCK_BOOST VIN EN GND VOUT PARAMS: VOUT_V=3.3
* Reduced TPS63802 3.3 V buck-boost observation behavior.
* The output is an ideal preliminary rail source gated by the datasheet VIN
* startup floor and EN. L1/L2 switching, FB dynamics, MODE/PG behavior,
* inductor current, thermal behavior, layout, EMI, and loop stability are
* intentionally not modeled.
BOUT VOUT GND V={VOUT_V/(1+exp(-4*(v(VIN,GND)-1.8)))/(1+exp(-20*(v(EN,GND)-1)))}
ROUT VOUT GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS63802_3V3_BUCK_BOOST

.subckt CIRCUITCI_TPS61023_5V_BOOST VIN EN GND VOUT PARAMS: VOUT_V=5
* Reduced TPS61023 5 V boost-regulator observation behavior.
* The output is an ideal preliminary rail source gated by the datasheet startup
* input floor and EN. SW switching, FB-loop dynamics, inductor current, ripple,
* current limit, thermal behavior, layout, EMI, and loop stability are
* intentionally not modeled.
BOUT VOUT GND V={VOUT_V/(1+exp(-4*(v(VIN,GND)-1.8)))/(1+exp(-20*(v(EN,GND)-1)))}
ROUT VOUT GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS61023_5V_BOOST

.subckt CIRCUITCI_TPS2121_POWER_MUX IN1 IN2 GND OUT ILIM PARAMS: SELECT_INPUT=1
* Reduced TPS2121 power-mux observation behavior.
* SELECT_INPUT near 1 selects IN1; near 2 selects IN2. OUT is an ideal
* preliminary selected-source rail. Priority comparators, switchover droop,
* reverse-current magnitude, ILIM-derived current limit, soft-start, thermal
* behavior, and status output are intentionally not modeled.
BOUT OUT GND V={((1-(1/(1+exp(-20*(SELECT_INPUT-1.5)))))*v(IN1,GND)+(1/(1+exp(-20*(SELECT_INPUT-1.5))))*v(IN2,GND))}
RILIMBIAS ILIM GND 1G
ROUT OUT GND 1G
.ends CIRCUITCI_TPS2121_POWER_MUX

.subckt CIRCUITCI_TPS2115A_POWER_MUX IN1 IN2 GND OUT EN D0 D1 ILIM PARAMS: SELECT_INPUT=1
* Reduced TPS2115A autoswitching power-mux observation behavior.
* SELECT_INPUT near 1 selects IN1; near 2 selects IN2. OUT is an ideal
* preliminary selected-source rail. EN/D0/D1/VSNS autoswitch truth-table logic,
* switchover droop, reverse-current magnitude, ILIM-derived current limit,
* thermal behavior, and package/layout sign-off are intentionally not modeled.
BOUT OUT GND V={((1-(1/(1+exp(-20*(SELECT_INPUT-1.5)))))*v(IN1,GND)+(1/(1+exp(-20*(SELECT_INPUT-1.5))))*v(IN2,GND))}
RBIAS_EN EN GND 1G
RBIAS_D0 D0 GND 1G
RBIAS_D1 D1 GND 1G
RILIMBIAS ILIM GND 1G
ROUT OUT GND 1G
.ends CIRCUITCI_TPS2115A_POWER_MUX

.subckt CIRCUITCI_TPS22918_LOAD_SWITCH VIN VOUT GND ON
* Reduced TPS22918 enabled high-side switch behavior.
* ON controls a smooth VIN-to-VOUT conductance near the datasheet typical
* 52 mOhm on-resistance. CT slew, QOD discharge, reverse-current behavior,
* thermal behavior, and current limiting are intentionally not modeled.
BSW VIN VOUT I={v(VIN,VOUT)*(1e-9 + 19.23/(1+exp(-20*(v(ON,GND)-1))))}
RLEAK VOUT GND 1G
RBIAS ON GND 1G
.ends CIRCUITCI_TPS22918_LOAD_SWITCH

.subckt CIRCUITCI_TPS25948_EFUSE_RCB VIN VOUT GND EN
* Reduced TPS25948 enabled eFuse/load-switch observation behavior.
* EN controls a smooth VIN-to-VOUT conductance near the datasheet maximum
* 20 mOhm on-resistance. The source-backed component metadata carries the
* 8 A current-limit and always-on reverse-current-blocking facts. This
* subcircuit only observes enabled forward-path rail behavior; dVdt slew,
* ILM/ITIMER current limit, FLT/SPLYGD outputs, OVLO, RCBCTRL control,
* reverse-current dynamics, thermal behavior, and fault timing are
* intentionally not modeled.
BSW VIN VOUT I={v(VIN,VOUT)*(1e-9 + 50/(1+exp(-20*(v(EN,GND)-1.15))))}
RLEAK VOUT GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS25948_EFUSE_RCB

.subckt CIRCUITCI_TPS24751_CSD17501Q5A_HOT_SWAP VIN VOUT GND EN
* Reduced TPS24751 + CSD17501Q5A hot-swap/reverse-blocking observation behavior.
* EN controls a smooth VIN-to-VOUT conductance near the conservative combined
* 9.7 mOhm path resistance. The source-backed component metadata carries the
* 12 A current class, 11 A current-limit design point, inrush, and disabled-state
* reverse-blocking facts. This subcircuit only observes enabled forward-path
* rail behavior; TIMER/PROG/SET current limit, FLTb/PGb outputs, gate-drive,
* reverse-blocking dynamics, thermal behavior, and fault timing are intentionally
* not modeled.
BSW VIN VOUT I={v(VIN,VOUT)*(1e-9 + 103.09/(1+exp(-20*(v(EN,GND)-1.3))))}
RLEAK VOUT GND 1G
RBIAS EN GND 1G
.ends CIRCUITCI_TPS24751_CSD17501Q5A_HOT_SWAP

.subckt CIRCUITCI_MCP73831_4V2_CHARGER VDD VBAT VSS PROG
* Reduced MCP73831-2 constant-current/constant-voltage charger behavior.
* A 1 uA PROG bias makes the external RPROG voltage encode the datasheet
* IREG = 1000 V / RPROG relationship as ICHG = 0.001 / V(PROG,VSS).
* Thermal regulation, charge qualification, termination, STAT behavior, and
* battery chemistry are intentionally not modeled.
BPROG PROG VSS I=1u
BCHG VDD VBAT I={(0.001/sqrt(v(PROG,VSS)*v(PROG,VSS)+1e-12))/(1+exp(25*(v(VBAT,VSS)-4.2)))}
BCLAMP VBAT VSS I={5*(v(VBAT,VSS)-4.2+sqrt((v(VBAT,VSS)-4.2)*(v(VBAT,VSS)-4.2)+1e-8))}
RLEAK VBAT VSS 1G
.ends CIRCUITCI_MCP73831_4V2_CHARGER

.subckt CIRCUITCI_BQ24075_POWER_PATH_CHARGER IN BAT OUT VSS ISET
* Reduced BQ24075 power-path charger behavior.
* A 1 uA ISET bias makes the external RISET voltage encode the datasheet
* ICHG = 890 / RISET relationship as ICHG = 0.00089 / V(ISET,VSS).
* OUT is a smooth preliminary min(IN, 5.5 V) behavioral rail source. DPPM,
* supplement mode, input-current limiting, thermal behavior, and termination
* are intentionally not modeled.
BISET ISET VSS I=1u
BCHG IN BAT I={(0.00089/sqrt(v(ISET,VSS)*v(ISET,VSS)+1e-12))/(1+exp(25*(v(BAT,VSS)-4.2)))}
BOUT OUT VSS V={0.5*(v(IN,VSS)+5.5-sqrt((v(IN,VSS)-5.5)*(v(IN,VSS)-5.5)+1e-6))}
BCLAMP BAT VSS I={5*(v(BAT,VSS)-4.2+sqrt((v(BAT,VSS)-4.2)*(v(BAT,VSS)-4.2)+1e-8))}
RLEAK BAT VSS 1G
.ends CIRCUITCI_BQ24075_POWER_PATH_CHARGER

.subckt CIRCUITCI_BQ25798_NVDC_CHARGER VBUS SYS BAT GND PARAMS: ICHG_A=1 VSYS_V=12 VBAT_REG_V=16.8
* Reduced BQ25798 buck-boost/NVDC charger observation behavior.
* ICHG_A is a host-declared charge-current setting from Board IR component
* parameters. SYS is an ideal preliminary observation rail while VBUS is above
* the datasheet input floor. Buck-boost switching, DPM/MPPT, BATFET supplement
* mode, register sequencing, thermal behavior, and cell-safety behavior are
* intentionally not modeled.
BCHG VBUS BAT I={ICHG_A/(1+exp(8*(v(BAT,GND)-VBAT_REG_V)))}
BSYS SYS GND V={VSYS_V/(1+exp(-4*(v(VBUS,GND)-3.6)))}
BCLAMP BAT GND I={2*(v(BAT,GND)-VBAT_REG_V+sqrt((v(BAT,GND)-VBAT_REG_V)*(v(BAT,GND)-VBAT_REG_V)+1e-8))}
RLEAK BAT GND 1G
.ends CIRCUITCI_BQ25798_NVDC_CHARGER

.subckt CIRCUITCI_TLV803EA29_RESET_SUPERVISOR VDD GND RESET
* Reduced TLV803EA29 active-low open-drain threshold behavior.
* RESET is strongly pulled low while VDD is below the nominal 2.93 V threshold
* and otherwise relies on an external pull-up resistor in the circuit. The
* logistic conductance avoids hard switching discontinuities.
BRESET RESET GND I={v(RESET,GND)*(1e-9 + 1/(1+exp(80*(v(VDD,GND)-2.93))))}
RLEAK RESET GND 1G
.ends CIRCUITCI_TLV803EA29_RESET_SUPERVISOR

.subckt CIRCUITCI_NL27WZ17_DUAL_BUFFER VCC GND A1 Y1 A2 Y2 PARAMS: A1_STATE=1 A2_STATE=0
* Reduced NL27WZ17 dual non-inverting Schmitt-trigger buffer observation behavior.
* A1_STATE and A2_STATE are explicit Board IR observation parameters. Inputs
* and outputs are ideal static logic levels referenced to VCC. Schmitt
* thresholds, hysteresis, propagation delay, output drive strength, package
* parasitics, capacitive loading, signal integrity, and final timing sign-off
* are intentionally not modeled.
BA1 NA1 GND V={v(VCC,GND)*A1_STATE}
RA1 NA1 A1 50
BY1 NY1 GND V={v(VCC,GND)*A1_STATE}
RY1 NY1 Y1 50
BA2 NA2 GND V={v(VCC,GND)*A2_STATE}
RA2 NA2 A2 50
BY2 NY2 GND V={v(VCC,GND)*A2_STATE}
RY2 NY2 Y2 50
RVCC VCC GND 1G
.ends CIRCUITCI_NL27WZ17_DUAL_BUFFER

.subckt CIRCUITCI_JST_XH_3PIN_CONTACTS VCC VCC_LOAD GND GND_LOAD SIG SIG_LOAD
* Reduced JST XH 3-circuit mated-contact observation behavior.
* Each contact uses the datasheet post-environment maximum 20 mOhm value.
* Housing, cable, crimp quality, temperature rise, retention, vibration, and
* signal-integrity behavior are intentionally not modeled.
RVCC VCC VCC_LOAD 0.02
RGND GND GND_LOAD 0.02
RSIG SIG SIG_LOAD 0.02
.ends CIRCUITCI_JST_XH_3PIN_CONTACTS

.subckt CIRCUITCI_JST_VH_8PIN_CONTACTS VBAT VBAT_LOAD GND GND_LOAD CANH CANH_LOAD CANL CANL_LOAD AUX_5V AUX_5V_LOAD ENABLE ENABLE_LOAD FAULT FAULT_LOAD SYNC SYNC_LOAD
* Reduced JST VH 8-circuit mated-contact observation behavior.
* Each contact uses the datasheet post-test maximum 20 mOhm value. Parallel
* current sharing, cable/crimp/contact aging beyond the datasheet test value,
* temperature rise, retention, vibration, CAN/EMC/SI behavior, and harness
* qualification are intentionally not modeled.
RVBAT VBAT VBAT_LOAD 0.02
RGND GND GND_LOAD 0.02
RCANH CANH CANH_LOAD 0.02
RCANL CANL CANL_LOAD 0.02
RAUX AUX_5V AUX_5V_LOAD 0.02
REN ENABLE ENABLE_LOAD 0.02
RFAULT FAULT FAULT_LOAD 0.02
RSYNC SYNC SYNC_LOAD 0.02
.ends CIRCUITCI_JST_VH_8PIN_CONTACTS
